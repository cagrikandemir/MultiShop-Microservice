@model UpdateCargoCompanyDto;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Firma Düzenle</h4>
                <p> Firma ile ilgili işlemleri gerçekleştirebilirsiniz.</p>
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <label>Firma Id</label>
                        <input asp-for="CargoCompanyId" class="form-control" type="text" />
                        <br />
                        <label>Firma Adı</label>
                        <input asp-for="CargoCompanyName" class="form-control" type="text" />                        
                        <button type="submit" class="btn btn-primary">Güncelle</button>
                        <button type="submit" href="/Admin/Cargo/CargoCompanyList" class="btn btn-warning">Geri Dön</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
