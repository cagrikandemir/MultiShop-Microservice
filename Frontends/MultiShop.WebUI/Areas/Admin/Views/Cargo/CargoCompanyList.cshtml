@model List<ResultCargoCompanyDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Kargo Firma Listesi</h4>
                <p>Firma ile ilgili işlemleri gerçekleştirebilirsiniz.</p>
                <div class="bs-example" data-example-id="bordered-table">

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Kargo Firma Adı</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.CargoCompanyName</td>
                                    <td>
                                        <a href="/Admin/Cargo/DeleteCargoCompany/@item.CargoCompanyId" class="btn btn-danger">Sil</a>
                                    </td>
                                    <td>
                                        <a href="/Admin/Cargo/UpdateCargoCompany/@item.CargoCompanyId" class="btn btn-success">Güncelle</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Buton tablonun dışına kurallara uygun şekilde taşındı ve boşluk eklendi -->
                    <div class="mt-3">
                        <a href="/Admin/Cargo/CreateCargoCompany" class="btn btn-primary">Yeni Firma Girişi</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>