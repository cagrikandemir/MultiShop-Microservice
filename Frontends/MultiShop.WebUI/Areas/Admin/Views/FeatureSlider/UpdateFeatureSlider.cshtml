@model UpdateFeatureSliderDto
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Öne Çıkarılanları Düzenle</h4>
                <p> Öne Çıkarılanlar ile ilgili işlemleri gerçekleştirebilirsiniz.</p>
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <label>Öne Çıkarılan Id</label>
                        <input asp-for="FeatureSliderId" class="form-control" type="text" />
                        <br />
                        <label>Başlık</label>
                        <input asp-for="Title" class="form-control" type="text" />
                        <br />
                        <label>Açıklama</label>
                        <input asp-for="Description" class="form-control" type="text" />
                        <br />
                        <label>Görsel Url</label>
                        <input asp-for="ImageUrl" class="form-control" type="text" />
                        <br />
                        <label>Durum</label>
                        <input asp-for="Status" class="form-control" type="text" />
                        <br />
                        <button type="submit" class="btn btn-primary">Güncelle</button>
                        <button type="submit" href="/Admin/FeatureSlider/Index" class="btn btn-warning">Geri Dön</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
