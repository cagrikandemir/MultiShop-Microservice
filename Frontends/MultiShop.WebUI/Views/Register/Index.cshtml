@model CreateRegisterDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<title>Form-v4 by Colorlib</title>
	<!-- Mobile Specific Metas -->
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
	<!-- Font-->
	<link rel="stylesheet" type="text/css" href="~/RegisterUI/css/opensans-font.css">
	<link rel="stylesheet" type="text/css" href="~/RegisterUI/fonts/line-awesome/css/line-awesome.min.css">
	<!-- Jquery -->
	<link rel="stylesheet" href="https://jqueryvalidation.org/files/demo/site-demos.css">
	<!-- Main Style Css -->
	<link rel="stylesheet" href="~/RegisterUI/css/style.css" />
</head>
<body class="form-v4">
	<div class="page-content">
		<div class="form-v4-content">
			<div class="form-left">
				<h2>MultiShop E-Ticaret</h2>
				<p class="text-1">Alışveriş deneyimine hemen katılın! Hızlı ve güvenli bir kayıt ile size özel fırsatlara erişin.</p>
				<p class="text-2"> Hemen üye olun, güvenli ve hızlı alışverişin keyfini çıkarın.</p>
				<div class="form-left-last">
					<a type="submit" name="account" class="account" href="/Login/Index">Hesabım Var</a>
				</div>
			</div>
			<form class="form-detail" action="#" method="post">
				<h2>Kayıt Formu</h2>
				<div class="form-group">
					<div class="form-row form-row-1">
						<label for="first_name">İsim</label>
						<input type="text"  id="first_name" class="input-text" asp-for="Name">
					</div>
					<div class="form-row form-row-1">
						<label for="last_name">Soyisim</label>
						<input type="text" id="last_name" class="input-text" asp-for="SurName">
					</div>
					
				</div>
				<div class="form-row">
					<label for="your_email">Kullanıcı Adı</label>
					<input type="text" id="user_name" class="input-text" asp-for="UserName">
				</div>
				<div class="form-row">
					<label for="your_email">E-mail</label>
					<input type="text"  id="your_email" class="input-text" required pattern="[^@@]+@@[^@@]+.[a-zA-Z]{2,6}" asp-for="Email">
				</div>
				
				<div class="form-group">
					<div class="form-row form-row-1 ">
						<label for="password">Şifre</label>
						<input type="password"  id="password" class="input-text" required asp-for="Password">
					</div>
					<div class="form-row form-row-1">
						<label for="comfirm-password">Şifre Doğrulayın</label>
						<input type="password" id="comfirm_password" class="input-text" required asp-for="PassordConfirm">
					</div>
				</div>
				<div class="form-checkbox">
					<label class="container"><p><a href="#" class="text">Şartları Ve Koşulları Kabul Ediyorum.</a></p>
					  	<input type="checkbox" name="checkbox">
					  	<span class="checkmark"></span>
					</label>
				</div>
				<div class="form-row-last">
					<input type="submit" name="register" class="register" value="Kayıt Ol">
				</div>
			</form>
			
		</div>
	</div>
	<script src="https://code.jquery.com/jquery-1.11.1.min.js"></script>
	<script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/jquery.validate.min.js"></script>
	<script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
	<script>
		// just for the demos, avoids form submit
		jQuery.validator.setDefaults({
		  	debug: true,
		  	success:  function(label){
        		label.attr('id', 'valid');
   		 	},
		});
		$( "#myform" ).validate({
		  	rules: {
			    password: "required",
		    	comfirm_password: {
		      		equalTo: "#password"
		    	}
		  	},
		  	messages: {
		  		first_name: {
		  			required: "Please enter a firstname"
		  		},
		  		last_name: {
		  			required: "Please enter a lastname"
		  		},
		  		your_email: {
		  			required: "Please provide an email"
		  		},
		  		password: {
	  				required: "Please enter a password"
		  		},
		  		comfirm_password: {
		  			required: "Please enter a password",
		      		equalTo: "Wrong Password"
		    	}
		  	}
		});
	</script>
</body><!-- This templates was made by Colorlib (https://colorlib.com) -->
</html>