
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

@await Component.InvokeAsync("_HeadUILayoutComponentPartial")
<body>
    <!-- Topbar Start -->
@await Component.InvokeAsync("_TopBarUILayoutComponentPartial")
    <!-- Topbar End -->
    <!-- Navbar Start -->
@await Component.InvokeAsync("_NavbarUILayoutComponentPartial")
    <!-- Navbar End -->
@RenderBody()
 
    <!-- Footer Start -->
@await Component.InvokeAsync("_FooterUILayoutComponentPartial")
    <!-- Footer End -->
    <!-- Back to Top -->
    <a href="#" class="btn btn-primary back-to-top"><i class="fa fa-angle-double-up"></i></a>


    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="/_UI/_UILib/easing/easing.min.js"></script>
    <script src="/_UI/_UILib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Contact Javascript File -->
    <script src="/_UI/_UImail/jqBootstrapValidation.min.js"></script>
    <script src="/_UI/_UImail/contact.js"></script>

    <!-- Template Javascript -->
    <script src="/_UI/_UIjs/main.js"></script>
</body>

</html>